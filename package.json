{
  "name": "noah-frontend",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.0.0",
    "npm": ">=10 <11"
  },
  "scripts": {
    "ng": "ng",
    "postinstall": "patch-package",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "build:prod": "cross-env NODE_ENV=production ng build --configuration production && cp $(pwd)/.netlify/_redirects $(pwd)/dist/noah-frontend/_redirects",
    "build-noah-ph": "cross-env NODE_ENV=production ng build -c=noahPH && cp $(pwd)/.netlify/_redirects $(pwd)/dist/noah-frontend/_redirects",
    "version": "conventional-changelog -p angular -i CHANGELOG.md -s && git add CHANGELOG.md"
  },
  "dependencies": {
    "@angular/animations": "21.2.24",
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "@angular/service-worker": "21.2.24",
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "@mapbox/mapbox-gl-geocoder": "5.1.2",
    "@turf/area": "6.5.0",
    "@turf/length": "6.5.0",
    "highcharts": "9.3.3",
    "mapbox-gl": "3.32.0",
    "ngx-google-analytics": "14.0.1",
    "rxjs": "7.8.2",
    "supercluster": "9.1.0",
    "swiper": "7.4.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.24",
    "@angular-eslint/builder": "21.4.0",
    "@angular/cli": "21.2.24",
    "@angular/compiler-cli": "21.2.24",
    "@eslint/js": "9.39.5",
    "@types/geojson": "7946.0.8",
    "@types/jasmine": "5.1.15",
    "@types/node": "22.20.4",
    "angular-eslint": "21.4.0",
    "conventional-changelog-cli": "^2.1.1",
    "cross-env": "7.0.3",
    "eslint": "9.39.5",
    "husky": "^4.3.8",
    "jasmine-core": "~5.13.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.1.1",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "1.7.0",
    "patch-package": "^8.0.1",
    "prettier": "2.4.1",
    "pretty-quick": "^3.1.1",
    "tailwindcss": "^2.2.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "husky": {
    "hooks": {
      "pre-commit": "pretty-quick --staged"
    }
  }
}
